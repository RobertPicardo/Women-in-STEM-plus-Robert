# so101_utils.py
import numpy as np
from pathlib import Path
from lerobot.motors import Motor, MotorCalibration, MotorNormMode
from lerobot.motors.feetech import FeetechMotorsBus, OperatingMode
import draccus
import json

# Joint order MUST match env-2.yaml: Shoulder_Rotation, Shoulder_Pitch,
# Elbow, Wrist_Pitch, Wrist_Roll, Gripper
MOTOR_IDS = {
    "Shoulder_Rotation": 1,
    "Shoulder_Pitch":    2,
    "Elbow":             3,
    "Wrist_Pitch":       4,
    "Wrist_Roll":        5,
    "Gripper":           6,
}

JOINT_ORDER = [
    "Shoulder_Rotation",
    "Shoulder_Pitch",
    "Elbow",
    "Wrist_Pitch",
    "Wrist_Roll",
    "Gripper",
]

ID_LIST = [MOTOR_IDS[j] for j in JOINT_ORDER]

# Default joint positions from env-2.yaml init_state (radians)
# Used to compute relative joint positions for the observation vector
DEFAULT_JOINT_POS_RAD = np.array([
    0.0,  # Shoulder_Rotation
    0.0,  # Shoulder_Pitch
    0.0,  # Elbow
    0.0,  # Wrist_Pitch
    0.0,  # Wrist_Roll
    0.3,  # Gripper (open)
])

def load_calibration(robot_name: str):
    """
    Load the LeRobot calibration JSON for SO-101.

    Returns the raw dict; FeetechMotorsBus accepts this.
    """
    calib_path = (
        Path("~/.cache/huggingface/lerobot/calibration/robots/so101_follower")
        .expanduser()
        / f"{robot_name}.json"
    )
    if not calib_path.exists():
        raise FileNotFoundError(
            f"No calibration found at {calib_path}. "
            f"Run: lerobot-calibrate --robot.type=so101_follower "
            f"--robot.port=<PORT> --robot.id={robot_name}"
        )

    with open(calib_path, "r") as f:
        calib = json.load(f)
    return calib

def setup_motors(port: str, robot_name: str) -> FeetechMotorsBus:
    calibration = load_calibration(robot_name)

    motors = {
        name: Motor(motor_id, "sts3215", MotorNormMode.RANGE_M100_100)
        for name, motor_id in MOTOR_IDS.items()
    }

    bus = FeetechMotorsBus(port=port, motors=motors, calibration=calibration)
    bus.connect()

    print("bus.motors keys:", list(bus.motors.keys()))



